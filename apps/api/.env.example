NODE_ENV=development
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
TRUST_PROXY=false
THROTTLING_ENABLED=true
ROUTING_PROVIDER=mock
VALHALLA_BASE_URL=https://api-eu.stadiamaps.com
VALHALLA_ROUTE_PATH=/route/v1
VALHALLA_TRACE_ATTRIBUTES_PATH=/trace_attributes/v1
VALHALLA_API_KEY=
VALHALLA_CLIENT_ID=route-cost
VALHALLA_REQUEST_TIMEOUT_MS=8000
VALHALLA_MAX_ALTERNATIVES=2
GEOCODING_PROVIDER=mock
STADIA_GEOCODING_BASE_URL=https://api-eu.stadiamaps.com
STADIA_GEOCODING_AUTOCOMPLETE_PATH=/geocoding/v2/autocomplete
STADIA_GEOCODING_SEARCH_PATH=/geocoding/v2/search
STADIA_GEOCODING_PLACE_DETAILS_PATH=/geocoding/v2/place_details
STADIA_GEOCODING_REVERSE_PATH=/geocoding/v2/reverse
STADIA_GEOCODING_API_KEY=
STADIA_GEOCODING_CLIENT_ID=route-cost
STADIA_GEOCODING_REQUEST_TIMEOUT_MS=5000
STADIA_GEOCODING_DEFAULT_LIMIT=5
STADIA_GEOCODING_MAX_LIMIT=10
FUEL_PRICE_PROVIDER_MODE=mock
SPAIN_FUEL_PRICE_SOURCE_URL=https://energia.serviciosmin.gob.es/ServiciosRestCarburantes/PreciosCarburantes/EstacionesTerrestres/
SPAIN_FUEL_PRICES_REQUEST_TIMEOUT_MS=10000
SPAIN_FUEL_PRICES_CACHE_TTL_MS=1800000
SPAIN_FUEL_PRICES_STALE_IF_ERROR_MS=21600000
FUEL_PRICE_RADIUS_STEPS_METRES=5000,10000,25000
FUEL_PRICE_MIN_STATION_COUNT=5
FUEL_PRICE_MAX_STATION_COUNT=30
FUEL_PRICE_MAX_DATA_AGE_HOURS=72
