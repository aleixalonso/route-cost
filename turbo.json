{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/tsconfig*.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    ".prettierignore",
    "**/.env.example"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "apps/web/dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {},
    "test:e2e": {
      "dependsOn": ["@route-cost/api#build", "@route-cost/web#build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
