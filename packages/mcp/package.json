{
  "name": "route-cost-mcp",
  "version": "0.1.0",
  "description": "Standalone stdio MCP server for RouteCost estimates",
  "license": "MIT",
  "type": "module",
  "bin": {
    "route-cost-mcp": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "route",
    "fuel",
    "cost"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleixalonso/route-cost.git",
    "directory": "packages/mcp"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('coverage',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@vitest/coverage-v8": "^5.1.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
